@@ -0,0 +1,72 @@
+package com.music.bitchord.assistant
+
+import java.net.HttpURLConnection
+import java.net.URL
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+
+internal class AssistantException(message: String) : Exception(message)
+
+/** A minimal client for the Anthropic Messages API, with no extra dependencies. */
+internal object AssistantClient {
+    private const val ENDPOINT = "https://api.anthropic.com/v1/messages"
+    private val json = Json { ignoreUnknownKeys = true }
+
+    suspend fun complete(
+        apiKey: String,
+        model: String,
+        system: String,
+        messages: List<JsonObject>,
+        tools: JsonArray,
+    ): Result<JsonObject> = withContext(Dispatchers.IO) {
+        runCatching {
+            val body = buildJsonObject {
+                put("model", model)
+                put("max_tokens", 1024)
+                put("system", system)
+                put("tools", tools)
+                put("messages", JsonArray(messages))
+            }.toString()
+            val conn = (URL(ENDPOINT).openConnection() as HttpURLConnection).apply {
+                requestMethod = "POST"
+                connectTimeout = 15_000
+                readTimeout = 60_000
+                doOutput = true
+                setRequestProperty("content-type", "application/json")
+                setRequestProperty("x-api-key", apiKey)
+                setRequestProperty("anthropic-version", "2023-06-01")
+            }
+            try {
+                conn.outputStream.use { it.write(body.toByteArray(Charsets.UTF_8)) }
+                val code = conn.responseCode
+                val stream = if (code in 200..299) conn.inputStream else conn.errorStream
+                val text = stream?.bufferedReader()?.use { it.readText() }.orEmpty()
+                if (code !in 200..299) throw AssistantException(describe(code, text))
+                json.parseToJsonElement(text).jsonObject
+            } finally {
+                conn.disconnect()
+            }
+        }
+    }
+
+    private fun describe(code: Int, body: String): String {
+        val detail = runCatching {
+            json.parseToJsonElement(body).jsonObject["error"]?.jsonObject
+                ?.get("message")?.jsonPrimitive?.content
+        }.getOrNull()
+        return when (code) {
+            401 -> "That API key was rejected. Check it in the assistant settings."
+            403 -> "This key isn't allowed to use that model."
+            404 -> "That model name wasn't found. Check the model in the assistant settings."
+            429 -> "Rate limit or credit limit reached. Try again in a moment."
+            else -> detail ?: "The AI service returned an error ($code)."
+        }
+    }
+}
