+import kotlinx.coroutines.withTimeoutOrNull
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonObjectBuilder
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.add
+import kotlinx.serialization.json.buildJsonArray
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+import kotlinx.serialization.json.putJsonArray
+import kotlinx.serialization.json.putJsonObject
+
+/** Chat state for the assistant, and the tools it can use to drive the player. */
+class AssistantViewModel(app: Application) : AndroidViewModel(app) {
+
+    data class Item(
+        val fromUser: Boolean,
+        val text: String,
+        val songs: List<Song> = emptyList(),
+        val isError: Boolean = false,
+    )
+
+    val items = mutableStateListOf<Item>()
+    var busy by mutableStateOf(false)
+        private set
+
+    private val history = mutableListOf<JsonObject>()
+    private var job: Job? = null
+
+    fun clear() {
+        job?.cancel()
+        history.clear()
+        items.clear()
+        busy = false
+    }
+
+    fun send(text: String, controller: MediaController?) {
+        val prompt = text.trim()
+        if (prompt.isEmpty() || busy) return
+        val context = getApplication<Application>()
+        val key = AssistantStore.apiKey(context)
+        if (key.isBlank()) {
+            items += Item(false, "Add your API key first (tap the gear).", isError = true)
+            return
+        }
+        items += Item(true, prompt)
+        history += buildJsonObject {
+            put("role", "user")
+            put("content", prompt)
+        }
+        trimHistory()
+        busy = true
+        job = viewModelScope.launch {
+            try {
+                converse(key, AssistantStore.model(context), controller)
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                items += Item(false, e.message ?: "Something went wrong.", isError = true)
+            } finally {
+                busy = false
+            }
+        }
+    }
+
+    /** Keeps the request small, never cutting between a tool call and its result. */
+    private fun trimHistory() {
+        while (history.size > 40) {
+            val next = (1 until history.size).firstOrNull { i ->
+                val m = history[i]
+                m["role"]?.jsonPrimitive?.contentOrNull == "user" && m["content"] is JsonPrimitive
+            } ?: break
+            repeat(next) { history.removeAt(0) }
+        }
+    }
+
+    private suspend fun converse(key: String, model: String, controller: MediaController?) {
+        val shown = mutableListOf<Song>()
+        var finalText = ""
+        repeat(6) {
+            val response = AssistantClient.complete(key, model, SYSTEM_PROMPT, history, TOOLS).getOrThrow()
+            val content = response["content"]?.jsonArray ?: JsonArray(emptyList())
+            history += buildJsonObject {
+                put("role", "assistant")
+                put("content", content)
+            }
+            val texts = content.map { it.jsonObject }
+                .filter { it["type"]?.jsonPrimitive?.contentOrNull == "text" }
+                .mapNotNull { it["text"]?.jsonPrimitive?.contentOrNull }
+            if (texts.isNotEmpty()) finalText = texts.joinToString("\n").trim()
+            val calls = content.map { it.jsonObject }
+                .filter { it["type"]?.jsonPrimitive?.contentOrNull == "tool_use" }
+            if (calls.isEmpty() || response["stop_reason"]?.jsonPrimitive?.contentOrNull != "tool_use") {
+                items += Item(false, finalText.ifBlank { "Done." }, shown.distinctBy { it.videoId })
+                return
+            }
+            val results = buildJsonArray {
+                for (call in calls) {
+                    val name = call["name"]?.jsonPrimitive?.contentOrNull.orEmpty()
+                    val args = call["input"] as? JsonObject ?: JsonObject(emptyMap())
+                    val output = try {
+                        runTool(name, args, controller, shown)
+                    } catch (e: CancellationException) {
+                        throw e
+                    } catch (e: Exception) {
+                        "Error: ${e.message}"
+                    }
+                    add(buildJsonObject {
+                        put("type", "tool_result")
+                        put("tool_use_id", call["id"]?.jsonPrimitive?.contentOrNull.orEmpty())
+                        put("content", output)
+                    })
+                }
+            }
+            history += buildJsonObject {
+                put("role", "user")
+                put("content", results)
+            }
+        }
+        items += Item(false, finalText.ifBlank { "Done." }, shown.distinctBy { it.videoId })
+    }
+
+    // ---- tools ----
+
+    private suspend fun findSong(query: String): Song? = try {
+        withTimeoutOrNull(8_000L) {
+            YtMusicRepository.search(query.trim().take(120), SearchFilter.ALL).getOrNull()
+        }?.firstNotNullOfOrNull {
+            when (it) {
+                is SearchResult.TopTrack -> it.song
+                is SearchResult.Track -> it.song
+                else -> null
+            }
+        }
+    } catch (e: CancellationException) {
+        throw e
+    } catch (_: Exception) {
+        null
+    }
+
+    private suspend fun findAll(queries: List<String>): List<Song> = coroutineScope {
+        queries.take(15).map { async { findSong(it) } }.awaitAll()
+    }.filterNotNull().distinctBy { it.videoId }
+
+    private fun label(song: Song) = "${song.title} by ${song.artist}"
+
+    private suspend fun runTool(
+        name: String,
+        args: JsonObject,
+        controller: MediaController?,
+        shown: MutableList<Song>,
+    ): String {
+        fun str(key: String) = args[key]?.jsonPrimitive?.contentOrNull?.trim().orEmpty()
+        fun list(key: String) = args[key]?.jsonArray
+            ?.mapNotNull { it.jsonPrimitive.contentOrNull?.trim()?.takeIf(String::isNotEmpty) }
+            .orEmpty()
+
+        if (name == "recommend_songs") {
+            val songs = findAll(list("songs"))
+            shown += songs
+            return if (songs.isEmpty()) "No matches found." else
+                "Shown to the user: " + songs.joinToString("; ") { label(it) }
+        }
+        val c = controller ?: return "The player isn't ready yet. Ask the user to try again in a moment."
+        return when (name) {
+            "play_song" -> {
+                val song = findSong(str("query")) ?: return "No match found for that search."
+                c.playSongs(listOf(song), 0)
+                shown += song
+                "Now playing ${label(song)}."
+            }
+            "play_playlist" -> {
+                val songs = findAll(list("songs"))
+                if (songs.isEmpty()) return "None of those songs could be found."
+                c.playSongs(songs, 0)
+                shown += songs
+                "Started a queue of ${songs.size} songs: " + songs.joinToString("; ") { label(it) }
+            }
+            "add_to_queue" -> {
+                val song = findSong(str("query")) ?: return "No match found for that search."
+                val next = args["play_next"]?.jsonPrimitive?.contentOrNull == "true"
+                if (c.mediaItemCount == 0) {
+                    c.playSongs(listOf(song), 0)
+                    return "Nothing was playing, so started ${label(song)}."
+                }
+                val timeline = (0 until c.mediaItemCount).map { c.getMediaItemAt(it).toSong() }
+                val at = QueueCoordinator.findUserQueueInsertionIndex(
+                    timeline = timeline,
+                    currentIndex = c.currentMediaItemIndex,
+                    isNext = next,
+                )
+                c.addMediaItem(at, song.asQueueEntry(QueueTier.USER_QUEUE).toMediaItem())
+                shown += song
+                if (next) "${label(song)} will play next." else "Added ${label(song)} to the queue."
+            }
+            "player_control" -> when (str("action")) {
+                "pause" -> { c.pause(); "Paused." }
+                "resume" -> { c.play(); "Resumed." }
+                "next" -> { c.seekToNextMediaItem(); "Skipped to the next song." }
+                "previous" -> { c.seekToPreviousMediaItem(); "Went back to the previous song." }
+                else -> "Unknown action."
+            }
+            "set_sleep_timer" -> {
+                val minutes = args["minutes"]?.jsonPrimitive?.intOrNull ?: 0
+                if (minutes <= 0) {
+                    SleepTimer.cancel()
+                    "Sleep timer cancelled."
+                } else {
+                    SleepTimer.start(minutes.coerceAtMost(720))
+                    "Sleep timer set for ${minutes.coerceAtMost(720)} minutes."
+                }
+            }
+            "get_now_playing" -> {
+                val song = c.currentMediaItem?.toSong()
+                if (song == null) "Nothing is playing." else
+                    "${label(song)} (${if (c.isPlaying) "playing" else "paused"}), " +
+                        "${c.mediaItemCount} items in the queue."
+            }
+            else -> "Unknown tool."
+        }
+    }
+
+    companion object {
+        private const val SYSTEM_PROMPT =
+            "You are the built-in AI music assistant of Swarasync, an Android music app. " +
+                "Act with your tools instead of describing what you would do: to play, queue, skip or " +
+                "pause, call the matching tool. For recommendations, call recommend_songs with " +
+                "'Title Artist' strings. For a playlist or mood mix the user wants to hear, call " +
+                "play_playlist with 8 to 15 'Title Artist' strings. Replies are read on a phone, so " +
+                "keep them short and friendly. When asked about a song's meaning, explain themes and " +
+                "background in your own words; never quote lyrics. If you are unsure of a fact, say so."
+
+        private fun JsonObjectBuilder.stringProp(name: String, description: String) =
+            putJsonObject(name) {
+                put("type", "string")
+                put("description", description)
+            }
+
+        private fun JsonObjectBuilder.stringListProp(name: String, description: String) =
+            putJsonObject(name) {
+                put("type", "array")
+                put("description", description)
+                putJsonObject("items") { put("type", "string") }
+            }
+
+        private fun tool(
+            name: String,
+            description: String,
+            required: List<String> = emptyList(),
+            props: JsonObjectBuilder.() -> Unit = {},
+        ) = buildJsonObject {
+            put("name", name)
+            put("description", description)
+            putJsonObject("input_schema") {
+                put("type", "object")
+                putJsonObject("properties", props)
+                putJsonArray("required") { required.forEach { add(it) } }
+            }
+        }
+
+        private val TOOLS: JsonArray = buildJsonArray {
+            add(tool("play_song", "Search for one song and play it now.", listOf("query")) {
+                stringProp("query", "Song title and artist, e.g. 'Tum Hi Ho Arijit Singh'")
+            })
+            add(tool("play_playlist", "Start playing a list of songs as a new queue.", listOf("songs")) {
+                stringListProp("songs", "Up to 15 entries, each 'Title Artist'")
+            })
+            add(tool("add_to_queue", "Add one song to the queue, or play it next.", listOf("query")) {
+                stringProp("query", "Song title and artist")
+                putJsonObject("play_next") {
+                    put("type", "boolean")
+                    put("description", "True to play right after the current song")
+                }
+            })
+            add(tool("recommend_songs", "Show tappable song suggestions to the user without playing them.", listOf("songs")) {
+                stringListProp("songs", "Up to 10 entries, each 'Title Artist'")
+            })
+            add(tool("player_control", "Pause, resume, skip or go back.", listOf("action")) {
+                putJsonObject("action") {
+                    put("type", "string")
+                    putJsonArray("enum") { listOf("pause", "resume", "next", "previous").forEach { add(it) } }
+                }
+            })
+            add(tool("set_sleep_timer", "Pause playback after some minutes. Use 0 to cancel.", listOf("minutes")) {
+                putJsonObject("minutes") { put("type", "integer") }
+            })
+            add(tool("get_now_playing", "Get the current song and queue size."))
+        }
+    }
+}
