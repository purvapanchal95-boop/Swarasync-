@@ -0,0 +1,32 @@
+package com.music.bitchord.assistant
+
+import android.content.Context
+import com.music.bitchord.auth.EncryptedPrefs
+
+/**
+ * Where the assistant keeps the user's own Anthropic API key.
+ *
+ * The key is typed in by the user and stored on this device only, in the same
+ * encrypted store the app uses for its account credentials. Nothing is bundled
+ * in the APK, because a key shipped inside an app can be extracted by anyone.
+ */
+internal object AssistantStore {
+    const val DEFAULT_MODEL = "claude-sonnet-5-5"
+
+    private fun prefs(context: Context) =
+        EncryptedPrefs.open(context, "swarasync_ai_enc", "swarasync_ai_plain")
+
+    fun apiKey(context: Context): String =
+        prefs(context).getString("api_key", "").orEmpty()
+
+    fun setApiKey(context: Context, key: String) {
+        prefs(context).edit().putString("api_key", key.trim()).apply()
+    }
+
+    fun model(context: Context): String =
+        prefs(context).getString("model", DEFAULT_MODEL).orEmpty().ifBlank { DEFAULT_MODEL }
+
+    fun setModel(context: Context, model: String) {
+        prefs(context).edit().putString("model", model.trim()).apply()
+    }
+}
